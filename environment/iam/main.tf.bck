resource "aws_iam_policy" "tf_state_dev_policy" {
  name = "tf-state-dev-policy"
  path = "/"
  description = "Policy to allow terraform s3 backend creation and management"
  tags = {
    Author = "Florian Le Merle"
    Managed_by = "Terraform"
  }

  policy = jsonencode({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowDevStateBucketAccess",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::it-journey-tf-states-dev"
        },
        {
            "Sid": "AllowDevStateObjectAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::it-journey-tf-states-dev/*"
        },
        {
            "Sid": "AllowDevDynamoDBLocking",
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:DeleteItem"
            ],
            "Resource": "arn:aws:dynamodb:*:*:table/it-journey-tf-locks-dev"
        }
    ]
    })
}


resource "aws_iam_policy" "it_journey_dev_policy" {
  name = "it-journey-dev-policy"
  path = "/"
  description = "Policy to allow admin access to s3 bucket and cloudFront for dev environement of it-journey"
  tags = {
    Author = "Florian Le Merle"
    Managed_by = "Terraform"
    Environment = "Dev"
    }

  policy = jsonencode({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowScopedS3BucketOperations",
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": "arn:aws:s3:::it-journey-bucket-dev"
        },
        {
            "Sid": "AllowScopedS3ObjectOperations",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "arn:aws:s3:::it-journey-bucket-dev/*"
        },
        {
            "Sid": "AllowCloudFrontManagement",
            "Effect": "Allow",
            "Action": [
                "cloudfront:CreateDistribution",
                "cloudfront:GetDistribution",
                "cloudfront:UpdateDistribution",
                "cloudfront:DeleteDistribution",
                "cloudfront:TagResource",
                "cloudfront:UntagResource",
                "cloudfront:ListTagsForResource",
                "cloudfront:CreateOriginAccessControl",
                "cloudfront:GetOriginAccessControl",
                "cloudfront:UpdateOriginAccessControl",
                "cloudfront:DeleteOriginAccessControl",
                "cloudfront:CreateFunction",
                "cloudfront:PublishFunction",
                "cloudfront:DescribeFunction",
                "cloudfront:GetFunction",
                "cloudfront:DeleteFunction",
                "cloudfront:UpdateFunction"

            ],
            "Resource": "*"
        }
    ]
  })
}

resource "aws_iam_policy" "it_journey_prod_policy" {
  name = "it-journey-prod-policy"
  path = "/"
  description = "Policy to allow admin access to s3 bucket and cloudFront for prod environment of it-journey"
  tags = {
    Author = "Florian Le Merle"
    Managed_by = "Terraform"
    Environment = "Prod"
    }

    policy = jsonencode({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowScopedS3BucketOperations",
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": "arn:aws:s3:::it-journey-bucket-prod"
        },
        {
            "Sid": "AllowScopedS3ObjectOperations",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "arn:aws:s3:::it-journey-bucket-prod/*"
        },
        {
            "Sid": "AllowCloudFrontManagement",
            "Effect": "Allow",
            "Action": [
                "cloudfront:CreateDistribution",
                "cloudfront:GetDistribution",
                "cloudfront:UpdateDistribution",
                "cloudfront:DeleteDistribution",
                "cloudfront:TagResource",
                "cloudfront:UntagResource",
                "cloudfront:ListTagsForResource",
                "cloudfront:CreateOriginAccessControl",
                "cloudfront:GetOriginAccessControl",
                "cloudfront:UpdateOriginAccessControl",
                "cloudfront:DeleteOriginAccessControl",
                "cloudfront:CreateFunction",
                "cloudfront:PublishFunction",
                "cloudfront:DescribeFunction",
                "cloudfront:GetFunction",
                "cloudfront:DeleteFunction",
                "cloudfront:UpdateFunction"

            ],
            "Resource": "*"
        }
    ]
  })
}

resource "aws_iam_user_policy_attachment" "svc_terraform_dev" {
  user = "svc_terraform_dev"
  policy_arn = aws_iam_policy.it_journey_dev_policy.arn
}

resource "aws_iam_user_policy_attachment" "svc_terraform_prod" {
  user = "svc_terraform_prod"
  policy_arn = aws_iam_policy.it_journey_prod_policy.arn
}